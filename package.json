{
  "name": "tokenledger",
  "version": "2.0.0",
  "description": "Cross-platform AI token consumption monitor (Tauri 2 + React + Rust)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Geidorf/TokenLedger-open.git"
  },
  "homepage": "https://github.com/Geidorf/TokenLedger-open#readme",
  "bugs": {
    "url": "https://github.com/Geidorf/TokenLedger-open/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "version:check": "node scripts/check-version.mjs",
    "release:bump": "node scripts/increment-version.mjs --explicit-release",
    "test:frontend": "node scripts/run-frontend-tests.mjs",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "lint:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "build:web": "vite build",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "icons:check": "node scripts/generate-app-icons.mjs --check",
    "test:icons": "node --test scripts/generate-app-icons.test.mjs",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "check:docs": "node scripts/check-docs.mjs",
    "check:gates": "node scripts/check-required-gates.mjs",
    "check:paths": "node scripts/check-path-length.mjs",
    "test:paths": "node --test scripts/check-path-length.test.mjs",
    "test:run-health": "node --test scripts/check-run-health.test.mjs",
    "branch:audit": "node scripts/branch-audit.mjs --out cleanup-plan.json",
    "check:android:widget-previews": "node scripts/check-widget-preview-assets.mjs",
    "check:native:macos": "node scripts/check-macos-window-launch.mjs",
    "check:native:macos:single-instance": "node scripts/check-macos-window-launch.mjs --check-single-instance",
    "check:native:macos:reopen": "node scripts/check-macos-window-launch.mjs --check-reopen --require-visible",
    "test:native:contract": "node --test scripts/check-macos-window-launch.test.mjs",
    "check:commits": "node scripts/check-commit-message.mjs --range origin/main..HEAD",
    "check": "node scripts/run-checks.mjs",
    "check:release": "node scripts/run-release-checks.mjs",
    "test:release-manifest": "node --test scripts/release-manifest.test.mjs",
    "test:release-security": "node --test scripts/supabase-client-key.test.mjs scripts/production-migration-evidence.test.mjs scripts/find-private-android-release-run.test.mjs scripts/verify-android-upgrade-artifacts.test.mjs scripts/m10-public-rc-exit.test.mjs scripts/release-lineage.test.mjs scripts/run-supabase-release-gate.test.mjs scripts/check-docs.test.mjs scripts/archive-tasks.test.mjs scripts/check-required-gates.test.mjs",
    "supabase:verify:release": "node scripts/run-supabase-release-gate.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:preflight": "node scripts/check-public-rc-readiness.mjs",
    "release:production-migration-evidence": "node scripts/production-migration-evidence.mjs",
    "build:local": "node scripts/run-build-all-local.mjs",
    "build": "npm run version:check && tauri build",
    "build:debug": "npm run version:check && tauri build --debug",
    "android:build:debug": "npm run version:check && node scripts/run-android-gradle.mjs :app:packageConfiguredDebug",
    "android:check:offline": "node scripts/check-android-kotlin.mjs",
    "android:gradle": "node scripts/run-android-gradle.mjs",
    "android:screenshot": "node scripts/run-android-gradle.mjs :app:validateDebugScreenshotTest",
    "android:screenshot:update": "node scripts/run-android-gradle.mjs :app:updateDebugScreenshotTest",
    "android:lint": "node scripts/run-android-gradle.mjs :app:lintDebug",
    "android:apk": "node scripts/run-android-gradle.mjs :app:assembleDebug",
    "android:test": "node scripts/run-android-gradle.mjs testDebugUnitTest",
    "android:verify": "npm run version:check && node scripts/run-android-gradle.mjs testDebugUnitTest lintDebug assembleDebug",
    "android:verify-upgrade-artifacts": "node scripts/verify-android-upgrade-artifacts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
