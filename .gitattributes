# Ensure consistent line endings across Windows and macOS
* text=auto
*.sql text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
/src-tauri/Cargo.toml text eol=lf
# run 健康快照要按字节核验（SHA-256 与仓库内容一致），不能随平台换成 CRLF
scripts/fixtures/run-health-daemon-slice.txt text eol=lf
# 清点证据同样按字节核验：日志的 evidence_manifest 记的是 blob 内容哈希，
